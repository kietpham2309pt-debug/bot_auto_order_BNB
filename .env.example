# =========================================
# Telegram Bot
# =========================================
# Lấy từ @BotFather sau khi tạo bot
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# chat_id của nhóm/channel nhận thông báo ĐƠN MỚI
# - Group thường: dạng -100xxxxxxxx hoặc -xxxxxxxx
# - Channel: dạng -100xxxxxxxx
# - User cá nhân: số dương 9-10 chữ số
TELEGRAM_CHAT_ID_ORDERS=-1001234567890

# chat_id của nhóm nhận báo cáo KPI (có thể giống TELEGRAM_CHAT_ID_ORDERS nếu chung 1 nhóm)
TELEGRAM_CHAT_ID_KPI=-1001234567890

# =========================================
# Haravan API
# =========================================
HARAVAN_SHOP_DOMAIN=bosch-home-online.myharavan.com
HARAVAN_API_TOKEN=PASTE_TOKEN_HERE

# Tên showroom hiển thị trong tin nhắn đơn mới
SHOWROOM_NAME=Showroom Vincom Royal City

# =========================================
# KPI Targets (đơn vị: VND)
# =========================================
# Target doanh thu tháng hiện tại (vd 2.1 tỷ = 2100000000)
KPI_MONTHLY_TARGET=2100000000

# =========================================
# Misc
# =========================================
TIMEZONE=Asia/Ho_Chi_Minh

# Secret để verify request webhook đến từ Haravan (tùy chọn, khuyến nghị bật)
# Haravan ký HMAC SHA-256 base64 vào header X-Haravan-Hmac-Sha256
HARAVAN_WEBHOOK_SECRET=

# Secret để bảo vệ endpoint cron — KHUYẾN NGHỊ BẬT
# Sinh chuỗi ngẫu nhiên dài (vd: openssl rand -hex 32) và cấu hình cùng giá trị trên cron-job.org
# Cron sẽ pass header `Authorization: Bearer <secret>` hoặc query `?key=<secret>`
CRON_SECRET=
